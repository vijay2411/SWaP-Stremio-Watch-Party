{
  "manifest_version": 3,
  "name": "SWaP \u2014 Stremio Watch Party",
  "short_name": "SWaP",
  "version": "4.1.1",
  "description": "Watch together on Stremio Web: room codes, synchronized playback, chat and optional video calls.",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/vijay2411/SWaP-Stremio-Watch-Party",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SWaP \u2014 Stremio Watch Party",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.stremio.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
